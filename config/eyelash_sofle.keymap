#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    mtL1: mtL1 {
        compatible = "zmk,behavior-tap-dance";
        label = "MT L1";
        #binding-cells = <0>;
        bindings = <&mo 3>, <&to 3>;
    };

    hl: hl {
        compatible = "zmk,behavior-hold-tap";
        label = "Hold Layer";
        bindings = <&mo>, <&kp>;

        #binding-cells = <2>;
        tapping-term-ms = <150>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
            layers = <0>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };

        switch_to_base: switch_to_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(RS(F19)) &to 0>;
            label = "switch_to_base";
        };

        switch_to_gaming: switch_to_gaming {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(RS(F20)) &to 5>;
            label = "switch_to_gaming";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&mt RA(RIGHT_SHIFT) ESCAPE  &kp N1        &kp N2  &kp N3        &kp N4  &kp N5       &kp RA(KP_NUMBER_1)  &kp N6      &kp N7         &kp N8     &kp N9     &kp N0       &hl 6 KP_NUMBER_1
&mt RC(RIGHT_SHIFT) TAB     &kp Q         &kp W   &kp E         &kp R   &kp T        &kp RA(KP_NUMBER_3)  &kp Y       &kp U          &kp I      &kp O      &kp P        &kp LEFT_BRACKET
&mt LEFT_CONTROL BACKSPACE  &kp A         &kp S   &kp D         &kp F   &kp G        &kp RA(KP_NUMBER_4)  &kp H       &kp J          &kp K      &kp L      &kp SEMI     &kp APOS
&mt LEFT_SHIFT ENTER        &kp Z         &kp X   &kp C         &kp V   &kp B        &kp RA(KP_NUMBER_2)  &kp N       &kp M          &kp COMMA  &kp DOT    &kp FSLH     &kp RIGHT_SHIFT
&none                       &kp LEFT_ALT  &mo 4   &kp LEFT_GUI  &mo 1   &kp SPACE    &kp RA(KP_NUMBER_0)  &kp ESCAPE  &kp BACKSPACE  &mo 2      &kp ENTER  &key_repeat
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Base";
        };

        triangle_layer {
            display-name = "Triangle";
            bindings = <
&kp RA(ESCAPE)  &kp RA(N1)  &kp RA(N2)  &kp RA(N3)  &kp RA(N4)  &kp RA(N5)    &trans  &kp RA(N6)  &kp RA(N7)  &kp RA(N8)     &kp RA(N9)   &kp RA(N0)    &kp RA(F13)
&kp RA(TAB)     &kp RA(Q)   &kp RA(W)   &kp RA(E)   &kp RA(R)   &kp RA(T)     &trans  &kp RA(Y)   &kp RA(U)   &kp RA(I)      &kp RA(O)    &kp RA(P)     &kp RA(LEFT_BRACKET)
&trans          &kp RA(A)   &kp RA(S)   &kp RA(D)   &kp RA(F)   &kp RA(G)     &trans  &kp RA(H)   &kp RA(J)   &kp RA(K)      &kp RA(L)    &kp RA(SEMI)  &kp RA(APOS)
&trans          &kp RA(Z)   &kp RA(X)   &kp RA(C)   &kp RA(V)   &kp RA(B)     &trans  &kp RA(N)   &kp RA(M)   &kp RA(COMMA)  &kp RA(DOT)  &kp RA(FSLH)  &trans
&trans          &trans      &trans      &trans      &trans      &trans        &trans  &trans      &trans      &trans         &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        square_layer {
            display-name = "Square";
            bindings = <
&kp CAPSLOCK  &kp RC(N1)  &kp RC(N2)  &kp RC(N3)  &kp RC(N4)  &kp RC(N5)           &trans  &kp RC(N6)  &kp RC(N7)  &kp RC(N8)     &kp RC(N9)   &kp RC(N0)    &kp RC(KP_NUMBER_1)
&kp RC(TAB)   &kp RC(Q)   &kp RC(W)   &kp RC(E)   &kp RC(R)   &kp RC(T)            &trans  &kp RC(Y)   &kp RC(U)   &kp RC(I)      &kp RC(O)    &kp RC(P)     &kp RC(LEFT_BRACKET)
&trans        &kp RC(A)   &kp RC(S)   &kp RC(D)   &kp RC(F)   &kp RC(G)            &trans  &kp RC(H)   &kp RC(J)   &kp RC(K)      &kp RC(L)    &kp RC(SEMI)  &kp RC(APOS)
&trans        &kp RC(Z)   &kp RC(X)   &kp RC(C)   &kp RC(V)   &kp RC(B)            &trans  &kp RC(N)   &kp RC(M)   &kp RC(COMMA)  &kp RC(DOT)  &kp RC(FSLH)  &trans
&trans        &trans      &trans      &trans      &trans      &kp LA(BACKSPACE)    &trans  &trans      &trans      &trans         &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        circle_layer {
            bindings = <
&trans      &kp F1  &kp F2     &kp F3     &kp F4     &kp F5    &mmv MOVE_UP     &kp F6     &kp F7        &kp F8    &kp F9         &kp F10        &trans
&trans      &none   &none      &mkp MB4   &mkp MB5   &none     &mmv MOVE_DOWN   &kp PG_UP  &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &kp MINUS      &kp EQUAL
&trans      &none   &mkp MCLK  &mkp RCLK  &mkp LCLK  &none     &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT      &kp DOWN  &kp RIGHT      &kp BACKSLASH  &kp RIGHT_BRACKET
&trans      &trans  &trans     &trans     &trans     &trans    &mmv MOVE_RIGHT  &trans     &kp HOME      &kp END   &kp F11        &kp F12        &trans
&kp C_MUTE  &trans  &trans     &trans     &trans     &trans    &mkp LCLK        &trans     &trans        &trans    &trans         &trans
            >;

            display-name = "Circle";
            sensor-bindings = <&scroll_encoder>;
        };

        arrow_layer {
            bindings = <
&kp ENTER         &kp BACKSPACE      &kp PAGE_DOWN  &kp PAGE_UP  &trans         &trans    &trans  &kp F16  &kp F17  &kp F18  &kp F19  &kp F20  &kp F21
&kp N0            &kp GRAVE          &kp LA(LEFT)   &kp UP       &kp LA(RIGHT)  &trans    &trans  &kp F10  &kp F4   &kp F5   &kp F6   &kp F13  &kp F22
&kp HOME          &kp END            &kp LEFT       &kp DOWN     &kp RIGHT      &trans    &trans  &kp F11  &kp F1   &kp F2   &kp F3   &kp F14  &kp F23
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS      &kp EQUAL    &kp BACKSLASH  &trans    &trans  &kp F12  &kp F7   &kp F8   &kp F9   &kp F15  &kp F24
&trans            &trans             &trans         &trans       &trans         &trans    &trans  &trans   &trans   &trans   &trans   &trans
            >;

            label = "Arrow";
        };

        gaming_layer {
            display-name = "Gaming";
            bindings = <
&kp ESCAPE        &kp N1     &kp N2        &kp N3        &kp N4  &kp N5       &kp RA(KP_NUMBER_1)  &kp N6  &kp N7         &kp N8     &kp N9     &kp N0        &hl 6 KP_NUMBER_1
&kp TAB           &kp Q      &kp W         &kp E         &kp R   &kp T        &kp RA(KP_NUMBER_3)  &kp Y   &kp U          &kp I      &kp O      &kp P         &kp LEFT_BRACKET
&kp LEFT_CONTROL  &kp A      &kp S         &kp D         &kp F   &kp G        &kp RA(KP_NUMBER_4)  &kp H   &kp J          &kp K      &kp L      &kp SEMI      &kp APOS
&kp LEFT_SHIFT    &kp Z      &kp X         &kp C         &kp V   &kp B        &kp RA(KP_NUMBER_2)  &kp N   &kp M          &kp COMMA  &kp DOT    &kp FSLH      &kp RIGHT_SHIFT
&kp C_MUTE        &kp ENTER  &kp LEFT_ALT  &kp LEFT_GUI  &mo 1   &kp SPACE    &kp RA(KP_NUMBER_0)  &kp F1  &kp BACKSPACE  &mo 2      &kp ENTER  &kp LEFT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        system_layer {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4    &kp C_VOLUME_UP    &trans       &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_TOG  &kp KP_NUMBER_2    &trans
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &studio_unlock  &trans        &sys_reset      &kp C_VOLUME_DOWN  &sys_reset   &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &switch_to_base  &switch_to_gaming  &kp KP_NUMBER_3
&trans  &out OUT_USB  &out OUT_BLE    &trans          &trans        &soft_off       &trans             &soft_off    &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &kp KP_NUMBER_4  &kp KP_NUMBER_5    &kp KP_NUMBER_6
&kp A   &trans        &trans          &trans          &trans        &bootloader     &trans             &bootloader  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD    &kp KP_NUMBER_7
&trans  &trans        &trans          &trans          &trans        &trans          &kp C_MUTE         &trans       &trans           &trans           &trans           &trans
            >;

            display-name = "System";
            sensor-bindings = <&scroll_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        function_condition {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
